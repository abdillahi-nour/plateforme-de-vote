<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrustVote - Connexion Admin</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
          --primary-color: #6a11cb;
          --secondary-color: #2575fc;
          --accent-color: #ff5f6d;
          --btn-home-color: #4e73df;
        }
    
        body {
          font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
          background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
          min-height: 100vh;
        }
    
        .auth-container {
          max-width: 900px;
          border-radius: 15px;
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }
    
        .auth-illustration {
          background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
          color: white;
          padding: 3rem;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        }
    
        .auth-form {
          background: white;
          padding: 3rem;
          border-radius: 15px;
        }
    
        .logo {
          font-weight: 700;
          color: white;
          margin-bottom: 1.5rem;
          font-size: 2rem;
        }
    
        .btn-connect,
        .btn-admin {
          background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
          border: none;
          padding: 12px 30px;
          font-weight: 600;
          color: white;
          border-radius: 50px;
          transition: all 0.3s;
        }
    
        .btn-connect:hover,
        .btn-admin:hover {
          transform: translateY(-3px);
          box-shadow: 0 10px 20px rgba(106, 17, 203, 0.2);
        }
    
        .btn-home {
          background: var(--btn-home-color);
          border: none;
          padding: 12px 30px;
          font-weight: 600;
          color: white;
          border-radius: 50px;
          transition: all 0.3s;
        }
    
        .btn-home:hover {
          transform: translateY(-3px);
          box-shadow: 0 10px 20px rgba(78, 115, 223, 0.2);
        }
    
        .form-control {
          border-radius: 50px;
          padding: 12px 20px;
          border: 1px solid #e0e0e0;
        }
    
        .form-control:focus {
          border-color: var(--primary-color);
          box-shadow: 0 0 0 0.25rem rgba(106, 17, 203, 0.25);
        }
    
        .form-group {
          position: relative;
          margin-bottom: 1.5rem;
        }
    
        .input-icon {
          position: absolute;
          right: 15px;
          top: 50%;
          transform: translateY(-50%);
          color: #6a11cb;
          cursor: pointer;
        }
    
        .auth-illustration img {
          width: 180px;
          margin-bottom: 1.5rem;
        }
    
        .auth-illustration h2,
        .auth-illustration p {
          font-size: 1.2rem;
        }
    
        @media (max-width: 767px) {
          .auth-container {
            padding: 1rem;
          }
          .auth-illustration h2,
          .auth-illustration p {
            font-size: 1rem;
          }
        }
      </style>
</head>
<body>
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="auth-container">
            <div class="row g-0">
                <!-- Illustration -->
                <div class="col-lg-6 d-none d-lg-block auth-illustration text-center">
                    <h1 class="logo">Vote de Confiance</h1>
                    
                    <div class="vote-illustration mb-4">
                        <!-- Image d'illustration de l'admin -->
                        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Vote illustration" width="180" />
                    </div>
                    <p class="illustration-title">Authentification Administrateur</p>
                    <div class="text-center mt-4">
                        <p><i class="fas fa-shield-alt me-2"></i>Accédez à la gestion des élections en toute sécurité</p>
                    </div>
                </div>

                <!-- Formulaire de connexion -->
                <div class="col-lg-6 auth-form">
                    <div class="text-center mb-4 d-lg-none">
                        <h2 class="logo" style="color: var(--primary-color);">TrustVote</h2>
                    </div>

                    <!-- Affichage du message d'erreur si présent -->
                    <% if (typeof alertMsg !== 'undefined' && alertMsg) { %>
                        <div class="alert alert-danger text-center" role="alert">
                            <%= alertMsg %>
                        </div>
                        
                    <% } %>
                   

                    <form id="adminForm" method="post" action="/adlogin">
                      <div class="form-group mb-3">
                        <label for="adminEmail" class="form-label">
                          <i class="fas fa-envelope me-2"></i>Email</label>
                        
                        <input type="email" class="form-control" id="adminEmail" name="email_address" required>
                      </div>
                    
                      <div class="form-group">
                        <label for="loginPassword" class="form-label">
                            <i class="fas fa-lock me-2"></i>Mot de passe
                        </label>
                        <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="loginPassword" name="password" required>
                            <i class="fas fa-eye input-icon" onclick="togglePassword('loginPassword', this)"></i>
                        </div>
                    </div>
                    
                      <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-admin">
                          <i class="fas fa-sign-in-alt me-2"></i>Connexion
                        </button>
                      </div>
                    </form>
                    

                    <!-- Bouton Retour à l'Accueil -->
                    <div class="d-grid gap-2 mt-3">
                        <a href="/" class="btn btn-home w-100"><i class="fas fa-home me-2"></i>Retour à l'Accueil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(id, icon) {
            const input = document.getElementById(id);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
     <script>
      window.addEventListener('DOMContentLoaded', (event) => {
          const alertMsg = document.querySelector('.alert');
          if (alertMsg) {
              setTimeout(() => {
                  alertMsg.classList.add('fade');  // Ajoute une classe pour l'animation
                  setTimeout(() => {
                      alertMsg.style.display = 'none';
                  }, 200); // Attend la fin de l'animation
              }, 2000); // 5 secondes
          }
      });
  </script>
</body>
</html>
