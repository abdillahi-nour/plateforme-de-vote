<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Participer des votes</title>

  <!-- Fonts and Icons -->
  <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <!-- Bootstrap 5 -->
   
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

  <style>
    :root {
      --primary-color: #9b5de5;
      --secondary-color: #6c9eff;
      --primary-dark: #7e4bc2;
      --background-color: #f5f7fa;
      --text-color: #333;
      --text-light: #777;
      --border-color: #e0e0e0;
      --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
      --input-focus-color: #9b5de5;
      --success-color: #28a745;
      --info-color: #17a2b8;
      --warning-color: #ffc107;
    }

    body {
      margin: 0;
      font-family: 'Roboto', sans-serif;
      background: var(--background-color);
      color: var(--text-color);
    }

    .dashboard-container {
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar */
    .sidebar {
      width: 260px;
      background: white;
      box-shadow: 2px 0 10px rgba(0, 0, 0, 0.05);
      height: 100vh;
      position: fixed;
      z-index: 100;
    }

    .sidebar-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    }

    .sidebar-header h3 {
      color: white;
      margin: 0;
      font-weight: 700;
      font-size: 1.4rem;
    }

    .sidebar-header small {
      color: rgba(255, 255, 255, 0.8);
    }

    .sidebar-menu {
      padding: 1rem 0;
    }

    .nav-link {
      display: flex;
      align-items: center;
      padding: 0.8rem 1.5rem;
      color: var(--text-light);
      font-weight: 500;
      text-decoration: none;
      margin: 0.25rem 1rem;
      border-radius: 6px;
      transition: all 0.3s;
    }

    .nav-link:hover {
      background-color: rgba(155, 93, 229, 0.1);
      color: var(--primary-color);
    }

    .nav-link.active {
      background-color: var(--primary-color);
      color: white;
      box-shadow: 0 4px 8px rgba(155, 93, 229, 0.2);
    }

    .nav-link i {
      margin-right: 12px;
      font-size: 1.25rem;
    }

    .logout-link {
      margin-top: 1rem;
      border-top: 1px solid var(--border-color);
      padding-top: 1rem;
      color: #dc3545 !important;
    }

    .logout-link:hover {
      background-color: rgba(220, 53, 69, 0.1) !important;
    }

    /* Main Content */
    .main-content {
      margin-left: 260px;
      flex: 1;
      padding: 2rem;
    }

    .card {
      background: white;
      border-radius: 12px;
      box-shadow: var(--card-shadow);
      border: none;
      overflow: hidden;
    }

    .card-header {
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      color: white;
      padding: 1.25rem 1.5rem;
      font-size: 1.25rem;
      font-weight: 600;
      display: flex;
      align-items: center;
    }

    .card-header i {
      margin-right: 10px;
    }

    .card-body {
      padding: 2rem;
    }

    .form-label {
      font-weight: 500;
      color: var(--text-light);
      margin-bottom: 0.5rem;
    }

    .form-control {
      border-radius: 8px;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border-color);
      transition: all 0.3s;
    }

    .form-control:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 0.25rem rgba(155, 93, 229, 0.25);
    }

    .btn {
      border-radius: 8px;
      padding: 0.75rem 1.5rem;
      font-weight: 600;
      transition: all 0.3s;
    }

    .btn-primary {
      background-color: var(--primary-color);
      border-color: var(--primary-color);
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      border-color: var(--primary-dark);
    }

    .alert {
      border-radius: 8px;
      padding: 1rem;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .sidebar {
        width: 100%;
        height: auto;
        position: relative;
      }

      .main-content {
        margin-left: 0;
      }
    }
  </style>
</head>

<body>
     
<div class="position-fixed top-0 start-50 translate-middle-x p-3 w-100" style="z-index: 9999; max-width: 600px;">
  <div id="toastContainer" class="toast-container w-100"></div>
</div>
  <div class="dashboard-container">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <div class="sidebar-header">
        <h3><i class="fas fa-vote-yea"></i> Espace électeur</h3>
       
        <small>Gestion des électeurs</small>
      </div>
      
      <div class="sidebar-menu">
        <a href="/userInfo" class="nav-link">
        <i class="fas fa-info-circle"></i>
        <span> À propos du vote</span>
         
        </a>
        <a href="#" class="nav-link active">
          <i class="fas fa-user-check"></i>
          <span>S'inscrire au vote</span>
        </a>
        <a href="/dashboard" class="nav-link">
          <i class="fas fa-vote-yea"></i>
          <span>Participer au vote</span>
        </a>
        <a href="/result" class="nav-link">
          <i class="fas fa-poll"></i>
          <span>Voir les résultats</span>
        </a>
        <a href="/logout" class="nav-link logout-link">
          <i class="fas fa-sign-out-alt"></i>
          <span>Déconnexion</span>
        </a>
      </div>
    </div>


     <!-- Contenu Principal -->
<div class="main-content">
  <div class="content-area">
    <div class="row">
      
      <!-- Formulaire d'inscription -->
      <div class="col-md-6">
        <div class="card">
          <div class="card-header">
            <i class="fas fa-user-edit"></i>
            <span>Inscription au vote</span>
          </div>
          
          <div class="card-body">
          

            <form action='/registerdata' method="post" id="formInscriptionElecteur">
              <div class="mb-4">
                <label for="electionSelect" class="form-label">Élection</label>
                <select id="electionSelect" class="form-select" required>
                  <option disabled selected value="">── Choisir une élection ──</option>
                </select>
              </div>
              <div class="mb-4">
                <label for="aadharno" class="form-label">Numéro de CIN :</label>
                <input type="text" id="aadharno" class="form-control" name="aadharno" required>
              </div>
 
              
              <div class="mb-4">
                <label for="account_address" class="form-label">Adresse de compte  :</label>
                <input type="text" id="account_address" class="form-control" name="account_address" required>
              </div>
              
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-user-plus me-2"></i> S'inscrire pour voter
              </button>
            
              <% if (typeof alertMsg !== 'undefined') { %>
                <div id="loader" class="alert alert-info mt-4">
                  <%= alertMsg %>
                </div>
              <% } %>
            </form>
          </div>
        </div>
      </div>

    
      <!-- Informations utilisateur à droite -->
      <div class="col-md-6">
        <div class="card">
          <div class="card-header">
            <i class="fas fa-info-circle"></i>
            <span>Mes Informations</span>
          </div>
          
          <div class="card-body">
            <!-- Informations statiques de l'utilisateur -->
            <p><strong>Nom:</strong> Abdillahi Nour </p>
            <p><strong>Email:</strong> Abdillahi@example.com</p>
            <p><strong>Adresse de Compte :</strong> 0x1234567890abcdef1234567890abcdef12345678</p>
            <!-- Plus d'informations statiques ici -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


  </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/web3.min.js"></script>
<script src="js/truffle-contract.js"></script>
<script src="js/app.js"></script>


  <script>
    // Highlight active links
    document.querySelectorAll('.nav-link').forEach(link => {
      if(link.href === window.location.href) {
        link.classList.add('active');
      }
      
      link.addEventListener('click', function() {
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        this.classList.add('active');
      });
    });


  </script>
  <script>
    // Cache automatiquement l'alerte après 5 secondes
    setTimeout(() => {
      const loader = document.getElementById('loader');
      if (loader) loader.style.display = 'none';
    }, 5000);
  </script>
  
  <script>
    window.addEventListener('DOMContentLoaded', (event) => {
        const alertMsg = document.querySelector('.alert');
        if (alertMsg) {
            setTimeout(() => {
                alertMsg.classList.add('fade');  // Ajoute une classe pour l'animation
                setTimeout(() => {
                    alertMsg.style.display = 'none';
                }, 500); // Attend la fin de l'animation
            }, 5000); // 5 secondes
        }
    });
</script>
</body>

</html>
