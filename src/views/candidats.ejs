<!-- Page : Espace Candidat -->
<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="utf-8">
  <title>Espace Candidat</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Fonts & Icons -->
  <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body style="background-color: #f5f7fa; font-family: 'Roboto', sans-serif;">

  <div class="container py-5">
    <h2 class="mb-4 text-center text-primary"><i class="fas fa-user-tie me-2"></i>Espace Candidat</h2>
    <div class="row">

      <!-- Formulaire d'inscription candidat -->
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">
            <i class="fas fa-user-plus me-2"></i>Inscription Candidat
          </div>
          <div class="card-body">
            <form action="/addCandidate" method="post">
              <div class="mb-3">
                <label for="name" class="form-label">Nom complet :</label>
                <input type="text" id="name" name="name" class="form-control" required>
              </div>

              <div class="mb-3">
                <label for="age" class="form-label">Âge :</label>
                <input type="number" id="age" name="age" class="form-control" required>
              </div>

              <div class="mb-3">
                <label for="description" class="form-label">Description :</label>
                <textarea id="description" name="description" class="form-control" rows="3" required></textarea>
              </div>

              <div class="mb-3">
                <label for="photo" class="form-label">URL de la photo :</label>
                <input type="url" id="photo" name="photo" class="form-control" required>
              </div>

              <button type="submit" class="btn btn-primary">
                <i class="fas fa-plus-circle me-2"></i>Ajouter le candidat
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Liste des candidats -->
      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-header bg-secondary text-white">
            <i class="fas fa-users me-2"></i>Liste des Candidats
          </div>
          <div class="card-body">
            <% if (candidates && candidates.length > 0) { %>
              <% candidates.forEach(c => { %>
                <div class="border rounded p-3 mb-3 bg-white shadow-sm">
                  <p><strong>Nom :</strong> <%= c.name %></p>
                  <p><strong>Âge :</strong> <%= c.age %> ans</p>
                  <p><strong>Description :</strong> <%= c.description %></p>
                  <img src="<%= c.photo %>" alt="Photo de <%= c.name %>" class="img-fluid rounded" style="max-height: 100px;">
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-muted">Aucun candidat enregistré pour le moment.</p>
            <% } %>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
